# Host published address: 127.0.0.1 is local; 0.0.0.0 requires login.
BIND_ADDRESS=127.0.0.1
# Browser access port on the host; the container keeps listening on 7000.
PORT=7000
# Login password when LAN/remote access is enabled.
ACCESS_PASSWORD=pdf2zh
MAX_CONCURRENT_TASKS=2
MAX_UPLOAD_MB=100
SHUTDOWN_GRACE_SECONDS=600
# Set true only when accessing through HTTPS.
COOKIE_SECURE=false

# Published-image deployments (compose.image.yaml) only. Pin a version if needed.
IMAGE=ghcr.io/zincnan/pdf-ai-translator-server:latest

# To reuse an existing data volume, set its name and mark it external.
DATA_VOLUME=pdf-ai-translator-data
DATA_VOLUME_EXTERNAL=false
