[basic]
input_files = []
debug = false
gui = false
warmup = false
generate_offline_assets = "null"
restore_offline_assets = "null"
version = false

[translation]
min_text_length = 5
rpc_doclayout = "null"
lang_in = "en"
lang_out = "zh-CN"
output = "null"
qps = 200
ignore_cache = false
custom_system_prompt = "null"
glossaries = "null"
save_auto_extracted_glossary = false
pool_max_workers = "null"
term_qps = "null"
term_pool_max_workers = "null"
